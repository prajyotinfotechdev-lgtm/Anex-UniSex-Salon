  @@index([userId])
  @@index([createdAt])
}

model AIInsight {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetId     String          @db.Uuid
  targetType   String
  status       AIInsightStatus @default(PENDING)
  insightData  Json
  confidence   Decimal         @db.Decimal(5, 2)
  metadata     Json?
  modelVersion String?
  generatedAt  DateTime        @default(now())
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())

  @@index([targetId, targetType])
}

model Prediction {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetId       String   @db.Uuid
  targetType     String
  predictionType String
  predictedValue Json
  createdAt      DateTime @default(now())

  @@index([targetId, targetType])
  @@index([predictionType])
}

enum AssetStatus {
  PENDING
  PROCESSING
  PUBLISHED
  ARCHIVED
  ERROR
}

model MediaAsset {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String      @db.Uuid
  uploadedById     String      @db.Uuid
  originalFilename String
  filename         String
  mimeType         String
  format           String
  bytes            Int
  width            Int
  height           Int
  folder           String?
  caption          String?
  tags             String[]
  isFeatured       Boolean     @default(false)
  status           AssetStatus
  url              String?
  secureUrl        String?
  type             MediaType
  provider         String?
  providerId       String?
  usageCount       Int         @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  inspirationPostsHero   InspirationPost[]        @relation("HeroMedia")
  inspirationPostsBefore InspirationPost[]        @relation("BeforeMedia")
  galleryItems           InspirationGalleryItem[]
  employeeProfiles       Employee[]               @relation("EmployeeProfileImage")
  collectionCovers       InspirationCollection[]  @relation("CollectionCoverImage")
}

model InspirationPost {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  branchId       String? @db.Uuid
  employeeId     String? @db.Uuid
  serviceId      String? @db.Uuid
  heroMediaId    String? @db.Uuid
  beforeMediaId  String? @db.Uuid

  title            String
  slug             String
  description      String?
  status           String   @default("DRAFT")
  category         String?
  revenueGenerated Decimal? @db.Decimal(10, 2)
  bookmarkCount    Int      @default(0)
  tags             String[]
  isFeatured       Boolean  @default(false)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])

  heroMedia   MediaAsset? @relation("HeroMedia", fields: [heroMediaId], references: [id])
  beforeMedia MediaAsset? @relation("BeforeMedia", fields: [beforeMediaId], references: [id])

  galleryItems InspirationGalleryItem[]
  collections  InspirationPostCollection[]
  bookmarks    InspirationBookmark[]
  events       InspirationEvent[]
  appointments Appointment[]

  @@unique([organizationId, slug])
}

model InspirationGalleryItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspirationPostId String  @db.Uuid
  mediaId           String  @db.Uuid
  caption           String?
  sortOrder         Int     @default(0)

  post  InspirationPost @relation(fields: [inspirationPostId], references: [id], onDelete: Cascade)
  media MediaAsset      @relation(fields: [mediaId], references: [id])
}

model InspirationCollection {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String      @db.Uuid
  title          String
  slug           String
  description    String?
  coverImageId   String?     @db.Uuid
  coverImage     MediaAsset? @relation("CollectionCoverImage", fields: [coverImageId], references: [id])
  isPublic       Boolean     @default(true)
  sortOrder      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id])
  posts        InspirationPostCollection[]

  @@unique([organizationId, slug])
}

model InspirationPostCollection {
  inspirationPostId       String @db.Uuid
  inspirationCollectionId String @db.Uuid
  sortOrder               Int    @default(0)

  post       InspirationPost       @relation(fields: [inspirationPostId], references: [id], onDelete: Cascade)
  collection InspirationCollection @relation(fields: [inspirationCollectionId], references: [id], onDelete: Cascade)

  @@id([inspirationPostId, inspirationCollectionId])
}

model InspirationBookmark {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspirationPostId String   @db.Uuid
  customerId        String   @db.Uuid
  createdAt         DateTime @default(now())

  post     InspirationPost @relation(fields: [inspirationPostId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id])

  @@unique([inspirationPostId, customerId])
}

model InspirationEvent {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inspirationPostId String   @db.Uuid
  customerId        String?  @db.Uuid
  eventType         String
  metadata          Json?
  createdAt         DateTime @default(now())

  post InspirationPost @relation(fields: [inspirationPostId], references: [id], onDelete: Cascade)
}

model CustomerDevice {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String    @db.Uuid
  deviceId      String    @unique
  deviceName    String?
  tokenHash     String
  isTrusted     Boolean   @default(false)
  isRevoked     Boolean   @default(false)
  lastIpAddress String?
  lastUsedAt    DateTime?
  platform      String?
  browser       String?
  pushToken     String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
}

model CustomerPairingSession {
  pairingId   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  newDeviceId String
  customerId  String?  @db.Uuid
  isConsumed  Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model ServiceRequirement {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId        String            @db.Uuid
  type             RequirementType
  consultationType ConsultationType? // Required if type is CONSULTATION
  validityDays     Int? // How long is the requirement valid for (e.g. 90 days)
  isRequired       Boolean           @default(true)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// DOMAIN: CONSULTATION ENGINE (Phase 1)
model ConsultationRecord {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId    String           @db.Uuid
  appointmentId String?          @db.Uuid
  employeeId    String?          @db.Uuid
  type          ConsultationType
  date          DateTime         @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  employee    Employee?    @relation(fields: [employeeId], references: [id])

  hairConsultation    HairConsultation?
  skinConsultation    SkinConsultation?
  medicalConsultation MedicalConsultation?

  @@index([customerId])
  @@index([appointmentId])
}

model HairConsultation {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId   String  @unique @db.Uuid
  hairLength       String?
  hairType         String?
  chemicalHistory  String?
  hairDensity      String?
  currentCondition String?
  notes            String?

  consultation ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model SkinConsultation {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId String  @unique @db.Uuid
  skinType       String?
  sensitivity    String?
  skinConcerns   String?
  notes          String?

  consultation ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}

model MedicalConsultation {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  consultationId    String  @unique @db.Uuid
  allergies         String?
  contraindications String?
  medicalNotes      String?

  consultation ConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
}
