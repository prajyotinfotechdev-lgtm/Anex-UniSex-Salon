model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId      String        @db.Uuid
  customerId    String?       @db.Uuid
  appointmentId String?       @db.Uuid
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @db.Decimal(10, 2)
  discountTotal Decimal       @db.Decimal(10, 2)
  taxTotal      Decimal       @db.Decimal(10, 2)
  tipAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  roundOff      Decimal       @default(0.00) @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  amountPaid    Decimal       @default(0.00) @db.Decimal(10, 2)
  amountDue     Decimal       @db.Decimal(10, 2)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
