generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// DOMAIN 1: ENUMS
// ==========================================

enum RoleType {
  SYSTEM
  CUSTOM
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ConsultationType {
  HAIR
  SKIN
  BEARD
  MEDICAL
  NAIL
  SPA
  BRIDAL
}

enum RequirementType {
  CONSULTATION
  PATCH_TEST
  CONSENT_FORM
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOffType {
  VACATION
  SICK
  UNPAID
  OTHER
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  ON_LEAVE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOIDED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  GIFT_CARD
  WALLET
  LOYALTY_POINTS
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  SALE
  ADJUSTMENT_UP
  ADJUSTMENT_DOWN
  RETURN
  WASTAGE
  INTERNAL_TRANSFER
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum PackageStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum PricingType {
  FIXED
  STARTING_AT
  VARIABLE
  FREE
}

enum QuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  BOOLEAN
  DATE
  SCALE
}

enum NotificationType {
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DELIVERED
  READ
}

enum ActionType {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  REPORT
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum TaxType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum AppointmentSource {
  WALK_IN
  PHONE
  ONLINE
  APP
  WHATSAPP
  INSTAGRAM
  MANUAL
}

enum AppointmentBlockType {
  EXECUTION
  PROCESSING
  CLEANUP
}

enum InvoiceItemType {
  SERVICE
  PRODUCT
  PACKAGE
  MEMBERSHIP
  TIP
  FEE
}

enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  PDF
}

enum AppointmentHistoryAction {
  CREATED
  RESCHEDULED
  CANCELLED
  STATUS_CHANGED
  NO_SHOW
}

enum AIInsightStatus {
  PENDING
  APPLIED
  DISMISSED
  ARCHIVED
}

enum PaymentGateway {
  CASH
  RAZORPAY
  STRIPE
  PAYPAL
  PHONEPE
  PAYTM
  GPAY
  OTHER
}

// ==========================================
// DOMAIN 2: CORE
// ==========================================

model Organization {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  legalBusinessName  String?
  gstNumber          String?
  panNumber          String?
  registrationNumber String?
  ownerName          String?
  website            String?
  version            Int     @default(1)

  currencyCode String    @default("INR")
  countryCode  String    @default("IN")
  locale       String    @default("en-IN")
  dateFormat   String    @default("DD/MM/YYYY")
  timeFormat   String    @default("12h")
  weekStartDay DayOfWeek @default(MONDAY)

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zipCode      String?
  country      String?
  latitude     Float?
  longitude    Float?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)

  branches       Branch[]
  branding       BrandingConfiguration?
  invoiceConfig  InvoiceConfiguration?
  modules        OrganizationModule[]
  settingHistory OrganizationSettingHistory[]

  roles                 Role[]
  employees             Employee[]
  customers             Customer[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  membershipPlans       MembershipPlan[]
  packages              Package[]
  taxCategories         TaxCategory[]
  expenseCategories     ExpenseCategory[]
  vendors               Vendor[]
  productBrands         ProductBrand[]
  productCategories     ProductCategory[]
  products              Product[]
  consultationTemplates ConsultationTemplate[]
  notificationTemplates NotificationTemplate[]
  auditLogs             AuditLog[]
  tags                  Tag[]
  InspirationPost       InspirationPost[]
  InspirationCollection InspirationCollection[]
}

model Branch {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  branchCode     String? @unique
  name           String
  address        String?
  phone          String?
  email          String?
  managerId      String? @db.Uuid
  timeZone       String  @default("UTC")
  isDefault      Boolean @default(false)
  version        Int     @default(1)

  posCounters Int @default(1)
  cashDrawers Int @default(1)
  rooms       Int @default(0)
  chairs      Int @default(0)

  preferredByCustomers Customer[] @relation("CustomerPreferredBranch")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?
  isActive             Boolean    @default(true)

  organization Organization        @relation(fields: [organizationId], references: [id])
  workingHours BranchWorkingHour[]
  holidays     Holiday[]

  employeeBranches   EmployeeBranch[]
  serviceBranches    ServiceBranch[]
  appointments       Appointment[]
  invoices           Invoice[]
  expenses           Expense[]
  purchaseOrders     PurchaseOrder[]
  branchInventories  BranchInventory[]
  stockMovements     StockMovement[]
  attendances        Attendance[]
  goodsReceipts      GoodsReceipt[]
  timeOffRequests    TimeOffRequest[]
  calendarExceptions CalendarException[]
  InspirationPost    InspirationPost[]

  @@index([organizationId])
}

// ==========================================
// DOMAIN 18: SETTINGS & CONFIGURATION
// ==========================================

model BrandingConfiguration {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String  @unique @db.Uuid
  designTokens    Json    @default("{}")
  customerAppLogo String?
  adminLogo       String?

  organization Organization @relation(fields: [organizationId], references: [id])
}

model InvoiceConfiguration {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String  @unique @db.Uuid
  invoicePrefix      String  @default("INV-")
  receiptPrefix      String  @default("REC-")
  creditNotePrefix   String  @default("CN-")
  numberFormat       String  @default("{prefix}{YYYY}{MM}{sequence}")
  financialYearReset Boolean @default(true)
  footerText         String?
  terms              String?
  showQrCode         Boolean @default(true)
  gstLayout          Boolean @default(true)
  printTemplate      String  @default("standard_a4")

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Module {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key              String  @unique
  name             String
  category         String
  enabledByDefault Boolean @default(false)

  organizationModules OrganizationModule[]
}

model OrganizationModule {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  moduleId       String  @db.Uuid
  enabled        Boolean @default(false)
  plan           String  @default("BASIC")

  organization Organization @relation(fields: [organizationId], references: [id])
  module       Module       @relation(fields: [moduleId], references: [id])

  @@unique([organizationId, moduleId])
}

model OrganizationSettingHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  module         String
  field          String
  oldValue       Json?
  newValue       Json
  changedBy      String   @db.Uuid
  changedAt      DateTime @default(now())
  reason         String?

  organization Organization @relation(fields: [organizationId], references: [id])
}

model BranchWorkingHour {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String    @db.Uuid
  dayOfWeek DayOfWeek
  isOpen    Boolean   @default(true)
  openTime  DateTime? @db.Time
  closeTime DateTime? @db.Time

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, dayOfWeek])
}

model Holiday {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String    @db.Uuid
  date      DateTime  @db.Date
  title     String
  recurring Boolean   @default(false)
  fullDay   Boolean   @default(true)
  startTime DateTime? @db.Time
  endTime   DateTime? @db.Time

  branch Branch @relation(fields: [branchId], references: [id])
}

// ==========================================
// DOMAIN 3: AUTHENTICATION
// ==========================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isActive     Boolean   @default(true)

  userPermissions UserPermission[]
  employee        Employee?
}

model Role {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  type           RoleType
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)

  organization    Organization     @relation(fields: [organizationId], references: [id])
  employees       Employee[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

// ==========================================
// DOMAIN 4: EMPLOYEES
// ==========================================

model Employee {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @db.Uuid
  userId                String?              @unique @db.Uuid
  roleId                String               @db.Uuid
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  profileImageUrl       String?
  profileImageId        String?              @db.Uuid
  profileImage          MediaAsset?          @relation("EmployeeProfileImage", fields: [profileImageId], references: [id])
  bio                   String?
  dateOfJoining         DateTime?            @db.Date
  emergencyContactName  String?
  emergencyContactPhone String?
  calendarColor         String?
  preferredByCustomers  Customer[]           @relation("CustomerPreferredEmployee")
  consultationRecords   ConsultationRecord[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  deletedAt             DateTime?
  isActive              Boolean              @default(true)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])

  employeeBranches     EmployeeBranch[]
  employeeServices     EmployeeService[]
  employeeAvailability EmployeeAvailability[]
  attendances          Attendance[]
  timeOffRequests      TimeOffRequest[]
  appointmentItems     AppointmentItem[]
  paymentsReceived     Payment[]
  appointmentsCreated  Appointment[]          @relation("AppointmentCreatedBy")
  appointmentsUpdated  Appointment[]          @relation("AppointmentUpdatedBy")
  InspirationPost      InspirationPost[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([roleId])
  @@index([email])
  @@index([phone])
}

model EmployeeBranch {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @db.Uuid
  branchId   String   @db.Uuid
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@unique([employeeId, branchId])
  @@index([employeeId])
  @@index([branchId])
}

model EmployeeService {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String   @db.Uuid
  serviceId  String   @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@unique([employeeId, serviceId])
  @@index([employeeId])
  @@index([serviceId])
}

model EmployeeAvailability {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String    @db.Uuid
  dayOfWeek  DayOfWeek
  startTime  String
  endTime    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
}

model Attendance {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String           @db.Uuid
  branchId   String           @db.Uuid
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  status     AttendanceStatus
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([employeeId])
  @@index([branchId])
  @@index([date])
}

model TimeOffRequest {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employeeId String        @db.Uuid
  branchId   String        @db.Uuid
  type       TimeOffType
  status     TimeOffStatus @default(PENDING)
  startDate  DateTime
  endDate    DateTime
  reason     String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@index([employeeId])
  @@index([branchId])
  @@index([status])
}

model CalendarException {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId  String   @db.Uuid
  date      DateTime @db.Date
  isClosed  Boolean  @default(true)
  startTime String?
  endTime   String?
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([date])
}

// ==========================================
// DOMAIN 5: CUSTOMERS
// ==========================================

model Customer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  firstName      String
  lastName       String
  email          String?
  primaryPhone   String
  gender         Gender?
  dob            DateTime? @db.Date
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  notes          String?

  anniversary         DateTime? @db.Date
  preferredBranchId   String?   @db.Uuid
  preferredEmployeeId String?   @db.Uuid
  acceptsMarketing    Boolean   @default(true)
  acceptsSMS          Boolean   @default(true)
  acceptsWhatsApp     Boolean   @default(true)
  acceptsEmail        Boolean   @default(true)

  preferredBranch     Branch?              @relation("CustomerPreferredBranch", fields: [preferredBranchId], references: [id])
  preferredEmployee   Employee?            @relation("CustomerPreferredEmployee", fields: [preferredEmployeeId], references: [id])
  consultationRecords ConsultationRecord[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  isActive            Boolean              @default(true)

  organization         Organization          @relation(fields: [organizationId], references: [id])
  phones               CustomerPhone[]
  tags                 CustomerTag[]
  media                CustomerMedia[]
  loyaltyTransactions  LoyaltyTransaction[]
  walletTransactions   WalletTransaction[]
  memberships          CustomerMembership[]
  packages             CustomerPackage[]
  appointments         Appointment[]
  invoices             Invoice[]
  consultationForms    ConsultationForm[]
  appointmentHistories AppointmentHistory[]
  InspirationBookmark  InspirationBookmark[]
  CustomerDevice       CustomerDevice[]

  @@unique([organizationId, primaryPhone])
  @@index([organizationId])
  @@index([email])
  @@index([primaryPhone])
}

model CustomerPhone {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  phone      String
  label      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([phone])
}

model Tag {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  color          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id])
  customerTags CustomerTag[]

  @@index([organizationId])
}

model CustomerTag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String   @db.Uuid
  tagId      String   @db.Uuid
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  tag      Tag      @relation(fields: [tagId], references: [id])

  @@unique([customerId, tagId])
  @@index([customerId])
  @@index([tagId])
}

model CustomerMedia {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @db.Uuid
  url        String
  type       MediaType
  caption    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model LoyaltyTransaction {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String                 @db.Uuid
  points      Int
  type        LoyaltyTransactionType
  description String?
  createdAt   DateTime               @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model WalletTransaction {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String                @db.Uuid
  amount      Decimal               @db.Decimal(10, 2)
  type        WalletTransactionType
  description String?
  createdAt   DateTime              @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// ==========================================
// DOMAIN 6: MEMBERSHIPS
// ==========================================

model MembershipPlan {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  description    String?
  price          Decimal      @db.Decimal(10, 2)
  billingCycle   BillingCycle
  durationMonths Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)

  organization        Organization         @relation(fields: [organizationId], references: [id])
  benefits            MembershipBenefit[]
  customerMemberships CustomerMembership[]

  @@index([organizationId])
}

model MembershipBenefit {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipPlanId String       @db.Uuid
  serviceId        String?      @db.Uuid
  productId        String?      @db.Uuid
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)
  quantity         Int?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  membershipPlan MembershipPlan @relation(fields: [membershipPlanId], references: [id])
  service        Service?       @relation(fields: [serviceId], references: [id])
  product        Product?       @relation(fields: [productId], references: [id])

  @@index([membershipPlanId])
  @@index([serviceId])
  @@index([productId])
}

model CustomerMembership {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId       String           @db.Uuid
  membershipPlanId String           @db.Uuid
  status           MembershipStatus @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  customer       Customer                @relation(fields: [customerId], references: [id])
  membershipPlan MembershipPlan          @relation(fields: [membershipPlanId], references: [id])
  transactions   MembershipTransaction[]
  usages         MembershipUsage[]

  @@index([customerId])
  @@index([membershipPlanId])
  @@index([status])
}

model MembershipTransaction {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerMembershipId String        @db.Uuid
  invoiceId            String?       @db.Uuid
  amount               Decimal       @db.Decimal(10, 2)
  paymentDate          DateTime
  status               PaymentStatus
  createdAt            DateTime      @default(now())

  customerMembership CustomerMembership @relation(fields: [customerMembershipId], references: [id])
  invoice            Invoice?           @relation(fields: [invoiceId], references: [id])

  @@index([customerMembershipId])
  @@index([invoiceId])
}

model MembershipUsage {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerMembershipId      String   @db.Uuid
  appointmentItemId         String?  @db.Uuid
  invoiceItemId             String?  @db.Uuid
  snapshottedMembershipName String?
  snapshotData              Json
  createdAt                 DateTime @default(now())

  customerMembership CustomerMembership @relation(fields: [customerMembershipId], references: [id])
  appointmentItem    AppointmentItem?   @relation(fields: [appointmentItemId], references: [id])
  invoiceItem        InvoiceItem?       @relation(fields: [invoiceItemId], references: [id])

  @@index([customerMembershipId])
}

// ==========================================
// DOMAIN 7: PACKAGES
// ==========================================

model Package {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  validityDays   Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)

  organization     Organization      @relation(fields: [organizationId], references: [id])
  items            PackageItem[]
  customerPackages CustomerPackage[]

  @@index([organizationId])
}

model PackageItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageId String   @db.Uuid
